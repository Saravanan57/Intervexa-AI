NODE_ENV=production
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_production_jwt_secret
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=your_vercel_frontend_url
ALLOWED_ORIGINS=your_allowed_origins_list

# Redis Configuration (Optional - falls back to in-memory cache if omitted)
REDIS_URL=your_redis_connection_url

# Google Gemini API Key (Optional - falls back to simulated AI mode if omitted)
GEMINI_API_KEY=your_gemini_api_key

# SMTP Email Configuration (Optional - falls back to mock logging if omitted)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_sender_email

# Google OAuth Configuration (Optional - required for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth Configuration (Optional - required for Facebook sign-in)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Default Seed Admin Credentials (Optional)
DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=your_admin_email
DEFAULT_ADMIN_PASSWORD=your_admin_password
