PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.lafo579.mongodb.net/interviewai?appName=Cluster0
JWT_SECRET=super_secret_interviewai_jwt_key_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_54321
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Redis Configuration (Fallback to memory cache will be used if connection fails)
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini API Key (If empty, platform will run in Mock mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Nodemailer configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASS=mock_pass
SMTP_FROM="Intervexa AI" <noreply@intervexa.ai>

# Default Seed Admin Credentials
DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=admin@intervexa.ai
DEFAULT_ADMIN_PASSWORD=AdminPass123!
