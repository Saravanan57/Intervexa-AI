NODE_ENV=production
MONGO_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_production_jwt_secret
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
FRONTEND_URL=your_vercel_frontend_url
ALLOWED_ORIGINS=your_allowed_origins_list

# Redis Configuration (Optional - falls back to in-memory cache if omitted)
REDIS_URL=your_redis_connection_url

# Google Gemini API Key (Optional - falls back to simulated AI mode if omitted)
GEMINI_API_KEY=your_gemini_api_key

# Email Configuration (Choose ONE of the following options):
# Option A (RECOMMENDED FOR RENDER FREE TIER - Uses HTTPS port 443, never blocked):
# Resend API (Free account at https://resend.com - 3,000 emails/mo)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=Intervexa AI <onboarding@resend.dev>

# Option B (Alternative HTTP API - 300 free emails/day at https://brevo.com):
# BREVO_API_KEY=your_brevo_api_key

# Option C (Traditional SMTP - Note: Render free tier blocks outbound SMTP ports 25, 465, and 587.
# Use this option only on Render paid plans, VPS, or local development):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_sender_email

# Backend URL for OAuth callbacks (Optional - defaults to Render host)
BACKEND_URL=https://intervexa-ai-backend-5w9c.onrender.com

# Google OAuth Configuration (Optional - required for Google sign-in)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override for Google OAuth callback URL (defaults to ${BACKEND_URL}/api/auth/google/callback)
GOOGLE_CALLBACK_URL=https://intervexa-ai-backend-5w9c.onrender.com/api/auth/google/callback

# Facebook OAuth Configuration (Optional - required for Facebook sign-in)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
# Optional override for Facebook OAuth callback URL (defaults to ${BACKEND_URL}/api/auth/facebook/callback)
FACEBOOK_CALLBACK_URL=https://intervexa-ai-backend-5w9c.onrender.com/api/auth/facebook/callback

# Default Seed Admin Credentials (Optional)
DEFAULT_ADMIN_NAME=Admin User
DEFAULT_ADMIN_EMAIL=your_admin_email
DEFAULT_ADMIN_PASSWORD=your_admin_password
